<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 호환판 전용. cordova-android가 minSdk 24를 못박아 병합을 막는데, 이 앱은
         cordova 플러그인을 하나도 쓰지 않으므로(Capacitor 플러그인 2개뿐) 강제로 통과시킨다.
         Android 6.0 실기(에뮬레이터)에서 구동을 확인하고 배포한다. -->
    <uses-sdk tools:overrideLibrary="org.apache.cordova" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 화면이 앞에 없어도 호출을 계속 감시하는 상주 서비스 (윈도우판 트레이 상주에 해당) -->
        <service
            android:name=".YouCallService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- 전자칠판을 껐다 켜도 자동으로 다시 상주하도록 -->
        <receiver
            android:name=".BootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>

        <!-- 칠판이 HDMI로 넘어가며 앱을 죽여도 1분마다 스스로를 다시 세운다 -->
        <receiver
            android:name=".YouCallService$ReviveReceiver"
            android:enabled="true"
            android:exported="false" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- 화면이 꺼지면 안드로이드가 Wi-Fi를 끊는다. 서비스는 살아 있는데 서버에 못 물어보는
         상태가 되어 겉보기 증상이 절전과 똑같다 — WifiLock을 잡으려면 이 권한이 필요하다. -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- 화면 자동 꺼짐을 앱이 직접 "사용 안 함"으로 바꾸기 위한 권한.
         화면이 안 꺼지면 CPU·Wi-Fi·Doze 절전 연쇄가 아예 시작되지 않는다.
         사용자가 설정 메뉴를 찾아 헤매지 않도록, 허용만 받고 앱이 값을 넣는다. -->
    <uses-permission android:name="android.permission.WRITE_SETTINGS" tools:ignore="ProtectedPermissions" />
    <!-- 호출음이 너무 작으면 놓친다 — 울리는 동안만 알람 볼륨을 올렸다 되돌린다 -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- HDMI 입력 중에는 안드로이드 화면이 꺼진 것과 같아 시스템이 절전(Doze)에 들어간다.
         그러면 포그라운드 서비스라도 네트워크가 끊겨 호출을 못 받고, 화면을 깨우는 순간
         밀린 호출이 한꺼번에 뜬다(2026-09-02 제보 증상). 절전 제외를 요청할 수 있게 한다. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <!-- 다른 앱(수업자료 등)을 쓰는 중에도 호출 화면을 띄우기 위한 권한. 사용자가 설정에서 직접 허용해야 한다. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
</manifest>
